# SisAgua Configuration Contract
# Copiar este archivo a .env y ajustar valores para desarrollo o produccion

DEBUG=True
SECRET_KEY=django-insecure-sisagua-dev-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos (PostgreSQL)
# Formato: postgres://usuario:password@localhost:5432/sisagua_db
# Si DATABASE_URL está vacío o no configurado en dev local, Django puede usar SQLite en memoria para tests
DB_NAME=sisagua_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Seguridad y Sesiones
SESSION_COOKIE_AGE=1800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_HTTPONLY=True
